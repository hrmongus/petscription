{
  "$brand": "Howl & Oats",
  "color": {
    "ground": {
      "bone":    { "value": "#FBF8F2", "use": "digital ground, paper white" },
      "oatmilk": { "value": "#F4EBDC", "use": "primary ground — the brand's white" },
      "kraft":   { "value": "#D9C3A5", "use": "secondary ground, packaging stock" }
    },
    "ink": {
      "ink":      { "value": "#17150F", "onOatmilk": 15.44, "onKraft": 10.69 },
      "ink-soft": { "value": "#5A5445", "onOatmilk": 6.9 }
    },
    "house": {
      "loden": { "value": "#37503F", "onOatmilk": 7.46, "onKraft": 5.16 }
    },
    "accent": {
      "ember":     { "value": "#C25A2B", "onOatmilk": 3.71, "restriction": "display 24px+ / spot ink only" },
      "ember-ink": { "value": "#9E4420", "onOatmilk": 5.38, "restriction": "text-safe ember" },
      "turmeric":  { "value": "#E3A83C", "onInk": 8.63, "restriction": "fills and highlights; never type on light" },
      "dusk":      { "value": "#455565", "onOatmilk": 6.48, "onKraft": 4.49 }
    },
    "dark": {
      "bg": "#17150F", "surface": "#26221A", "text": "#F4EBDC",
      "text-mute": "#B9AF9C", "accent": "#8FAE96", "ember": "#E0794A", "rule": "#3A352A"
    }
  },
  "type": {
    "display": { "family": "Instrument Serif", "fallback": "Iowan Old Style, Georgia, serif", "minSize": "24px" },
    "text":    { "family": "Space Grotesk", "fallback": "Inter, system-ui, sans-serif", "weights": [400, 500, 700] },
    "mono":    { "family": "Space Mono", "fallback": "IBM Plex Mono, ui-monospace, monospace", "case": "uppercase", "tracking": "0.09em" },
    "scale":   { "ratio": 1.333, "base": "18px", "steps": ["12.5", "15", "18", "24", "42.6", "75.8", "134.6"] }
  },
  "space": { "base": 4, "steps": [4, 8, 16, 24, 40, 64, 104, 168] },
  "form":  { "radius": "2px", "radiusPill": "999px", "hairline": "1px", "rule": "#C9BBA4" }
}
