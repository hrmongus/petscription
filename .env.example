# Skopíruj do .env.local (necommitovať) a do Vercel → Settings → Environment Variables.
# Iba TEST MODE (Stripe test kľúče, FHB sandbox), kým nie je celý tok otestovaný (SPEC §0).
# Aj Production env (granula.sk) má zatiaľ test kľúče: test/live určuje iba kľúč, nikdy NODE_ENV/VERCEL_ENV.

# Prepínač predaja (lib/checkout-gate.ts): true = doručenie a platba pre všetkých. Inak iba s ?test=<token>.
CHECKOUT_ENABLED=false
# tajný token (min. 16 znakov, napr. openssl rand -hex 24); granula.sk/granule-na-mieru?test=<token>
CHECKOUT_TEST_TOKEN=

# produkcia: https://www.granula.sk (granula.sk presmeruje 308 na www; Stripe ani FHB presmerovania nesledujú)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Service role iba na serveri, obchádza RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode: sk_test_…, pk_test_…, whsec_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# FHB Kika API 3. Sandbox: docs uvádzajú https://api-dev.fhb.sk/v3, FHB v emaile https://api-stage.fhb.sk/v3 (overiť).
FHB_API_URL=
FHB_APP_ID=
FHB_SECRET=
# tajný token v notifikačných URL /api/fhb/notify/<typ>/<orderId>?t=…
FHB_NOTIFY_TOKEN=
# kódy služieb FHB (parcel_service); predvolené v public/granula/doprava-config.js (Packeta zasielkovna_sk, DPD dpd_sk),
# tu iba prepis. SPS kuriér ⚠️ kód od FHB.
FHB_SERVICE_PACKETA=
FHB_SERVICE_DPD=
FHB_SERVICE_SPS_COURIER=
# kontrola adresy pri kuriérovi; sandbox api-stage ju odmieta pri každej adrese → false
FHB_VALIDATE_ADDRESS=false

# Packeta widget v6 (klientska sekcia Packeta)
PACKETA_API_KEY=

# Resend (doména granula.sk)
# Resend (transakčné emaily, lib/email.ts). Bez kľúča sa emaily iba zalogujú (email_log status skipped), nič nespadne.
# EMAIL_FROM na doméne overenej v Resend, napr. Granula <objednavky@granula.sk>
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Vercel Cron (Authorization: Bearer …)
# Vercel Cron posiela Authorization: Bearer <CRON_SECRET>; bez neho cron endpointy vrátia 503 (openssl rand -hex 32)
CRON_SECRET=
# interné upozornenia (chyba FHB, nízky sklad, vrátená zásielka); bez neho iba log
ADMIN_EMAIL=
